Keep a snapshot of the box's own addresses

Reading VRRP with a packet socket (see vyatta-vrrp-core) means we also see
the adverts we sent ourselves. Deciding whether an advert is our own needs
the set of local addresses, so keep a getifaddrs() snapshot in global_data
and refresh it whenever netlink reports an address change.

Index: b/keepalived/core/global_data.c
===================================================================
--- a/keepalived/core/global_data.c
+++ b/keepalived/core/global_data.c
@@ -235,6 +235,15 @@ alloc_global_data(void)
 
 	PMALLOC(new);
 	INIT_LIST_HEAD(&new->email);
+	new->local_addresses = NULL;
+
+	if (getifaddrs(&(new->local_addresses)) == -1) {
+		log_message(LOG_ERR, "Failed to allocate getifaddrs, %d", errno);
+		free_email_list(&new->email);
+		FREE(new);
+		return NULL;
+	}
+
 	new->smtp_alert = -1;
 #ifdef _WITH_VRRP_
 	new->smtp_alert_vrrp = -1;
@@ -440,6 +449,10 @@ free_global_data(data_t **datap)
 	if (!data)
 		return;
 
+	if (data->local_addresses != NULL) {
+		freeifaddrs(data->local_addresses);
+		data->local_addresses = NULL;
+	}
 	free_email_list(&data->email);
 	FREE_CONST_PTR(data->network_namespace);
 	FREE_CONST_PTR(data->network_namespace_ipvs);
