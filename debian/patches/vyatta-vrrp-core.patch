+		if (vip->ifa.ifa_family == saddr.ss_family) {
+			if (vip->ifa.ifa_family == AF_INET) {
+				if (inet_inaddrcmp(vip->ifa.ifa_family, &vip->u.sin.sin_addr,
+								 &((struct sockaddr_in *)&saddr)->sin_addr) == 0) {
