+/*
+ * Before starting our SNMP agent we should check that the SNMP master agent is
+ * active. net-snmp gives an agent no clear way to know whether snmpd is running
+ * and connectable, so wait for its pid file to appear and take that as running.
+ * Without this, keepalived can fail to connect to SNMP after a reboot.
+ */
+void
+vrrp_snmp_check_for_daemon(thread_ref_t thread)
+{
+	defer_snmp_args_t *args = THREAD_ARG(thread);
+
+	if (access("/var/run/snmpd.pid", F_OK) != 0) {
+		log_message(LOG_DEBUG, "SNMPd is not running, re-checking in %d seconds.",
+			    (1 << args->retries));
+		/* Exponential backoff, capped at SNMP_RETRY_CEILING. */
+		thread_add_timer(thread->master, vrrp_snmp_check_for_daemon, args,
+				 (1 << args->retries) * TIMER_HZ);
+		if (args->retries < SNMP_RETRY_CEILING)
+			args->retries++;
+		return;
+	}
+
+	log_message(LOG_DEBUG, "SNMPd is running");
+	snmp_agent_init(args->socket, args->base_mib);
+	free(args);
+	vrrp_snmp_register_mibs();
+}
+
 void
 vrrp_snmp_agent_init(const char *snmp_socket_name)
 {
-	if (snmp_running)
+	defer_snmp_args_t *snmp_args;
+
+	if (snmp_running) {
+		vrrp_snmp_register_mibs();
 		return;
+	}
 
 	/* We let the check process handle the global OID if it is running and with snmp */
-	snmp_agent_init(snmp_socket_name, vrrp_handles_global_oid(global_data));
+	snmp_args = malloc(sizeof(defer_snmp_args_t));
+	if (!snmp_args) {
+		log_message(LOG_ERR, "Failed to allocate SNMP defer args");
+		return;
+	}
+	snmp_args->socket = snmp_socket_name;
+	snmp_args->base_mib = vrrp_handles_global_oid(global_data);
+	snmp_args->retries = 0;
+	thread_add_event(master, vrrp_snmp_check_for_daemon, snmp_args, 0);
+	log_message(LOG_INFO, "Check SNMP presence event added to scheduler.");
+}
 
